[resource]
script = ExtResource("1_script")
id = &"glimmerwood"
display_name = "The Glimmerwood"
ground_color = Color(0.16, 0.4, 0.36, 1)
ground_color_variance = 0.08
ground_glow = 0.45
surface_enabled = true
lore_note = "Forest where the ancient terraforming machines still run. What looks like foxfire is glimmer: nanomachine light along living wood and active Wellstones."
